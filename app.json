{
    "expo": {
        "name": "Pokédex",
        "slug": "pokedex",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/iconAppli.png",
        "scheme": "pokeapi",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/iconAndroid.png"
            },
            "package": "com.pepitouu.pokedex"
        },
        "edgeToEdgeEnabled": true,
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/iconSplash.png",
                    "resizeMode": "cover",
                    "backgroundColor": "#000000"
                }
            ],
            "expo-audio"
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "21f30125-f4df-400d-9ce4-995aef94c4d0"
            }
        }
    }
}
